# Public website configuration
#
# NEXT_PUBLIC_SITE_URL is an OPTIONAL override. src/lib/seo.ts already defaults
# to https://weemapsinai.com, and that default is the single source of truth for
# canonical URLs, hreflang alternates, robots.txt and sitemap.xml.
#
# Leave it UNSET on Vercel Production. It was previously set there to a stale
# vercel.app hostname, which made the live sitemap, robots.txt and every
# canonical advertise the wrong domain. Only set it for a deployment that is
# genuinely served from another origin (a staging domain, a local tunnel).
# NEXT_PUBLIC_SITE_URL=https://weemapsinai.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_WEEMAP_AI_ENABLED=false

# Marketing tags. Both default to the live WEEMAP SINAI containers, so leave
# them unset in production. Override to point a preview/staging deploy at a
# different container, or set to an empty string to switch the tag off.
# NEXT_PUBLIC_GTM_ID=GTM-K7BXCRC2
# NEXT_PUBLIC_FB_PIXEL_ID=1765899771082599

# Set to 'true' to hold ALL analytics until setTrackingConsent(true) is called
# (see src/lib/conversion.ts). Unset/false preserves today's behaviour, where
# GTM and the Meta Pixel load on every page. There is no consent banner yet.
# NEXT_PUBLIC_REQUIRE_CONSENT=false

# Server-only website credentials
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
WEEMAP_N8N_CHAT_WEBHOOK_URL=
WEEMAP_N8N_CHAT_SECRET=
